{
  "name": "toa-toa-api",
  "version": "1.1.0",
  "private": true,
  "description": "API e painel administrativo TOA-TOA integrados ao Supabase",
  "main": "db.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node db.js",
    "check": "node --check db.js && node --check public/app.js",
    "lint": "eslint db.js public/app.js test scripts",
    "test": "node --test",
    "security:secrets": "node scripts/check-secrets.js",
    "verify": "npm run check && npm run lint && npm test && npm run security:secrets"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.22.3",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "multer": "^2.5.0"
  },
  "devDependencies": {
    "eslint": "^9.17.0",
    "supertest": "^7.3.1"
  }
}
